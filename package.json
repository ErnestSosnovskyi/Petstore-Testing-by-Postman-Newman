{
  "name": "mock-rest-api",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "turn-on-api": "shx cp mockApi/db_back_up.yaml mockApi/db_stage.yaml && npx yaml-server --hotReload=off --autoStart=off --port 3000 --database ./mockApi/db_stage.yaml",
    "test:store": "newman run store.collection.json -r htmlextra --reporter-htmlextra-export testResults/store-report.html",
    "test:petstore": "newman run petstore.collection.json -r htmlextra --reporter-htmlextra-export testResults/petstore-report.html"
  },
  "keywords": [
    "api",
    "mock",
    "yaml-server",
    "rest",
    "ci-cd",
    "postman"
  ],
  "author": "Ernest Sosnovskyi",
  "license": "ISC",
  "dependencies": {
    "yaml-server": "^1.10.0"
  },
  "devDependencies": {
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "shx": "^0.4.0",
    "wait-on": "^9.0.10"
  }
}
